# Bot token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=
# Default server ID (optional). If unset, pass guildId to each tool.
DISCORD_GUILD_ID=
# Where snapshots are saved (optional). Default: ~/.diserverbuilder/snapshots
DISERVERBUILDER_SNAPSHOT_DIR=
# Set to 1 to expose only tools that cannot change Discord (optional)
DISERVERBUILDER_READONLY=
